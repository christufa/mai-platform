"""Fast CPU checks: training reduces loss, checkpoints resume correctly."""

from pathlib import Path

from {{ package_name }}.checkpoint import load_latest
from {{ package_name }}.config import load_config
from {{ package_name }}.train import train

SMOKE = Path(__file__).parents[1] / "configs" / "smoke.yaml"


def _cfg(tmp_path, *overrides):
    return load_config(["--config", str(SMOKE), f"ckpt_dir={tmp_path}", *overrides])


def test_loss_decreases(tmp_path):
    first = train(_cfg(tmp_path, "max_steps=20", "log_every=20", "run_name=a"))
    last = train(_cfg(tmp_path, "max_steps=200", "log_every=200", "run_name=b"))
    assert last["loss"] < first["loss"]


def test_resume_continues_from_checkpoint(tmp_path):
    train(_cfg(tmp_path, "max_steps=30"))
    state = load_latest(tmp_path / "smoke")
    assert state is not None and state["step"] == 30

    result = train(_cfg(tmp_path, "max_steps=50"))
    assert result["step"] == 50
    assert len(list((tmp_path / "smoke").glob("step_*.pt"))) <= 2  # keep_last


def test_overrides_are_typed(tmp_path):
    cfg = _cfg(tmp_path, "lr=1", "compile=true")
    assert cfg.lr == 1.0 and cfg.compile is True
