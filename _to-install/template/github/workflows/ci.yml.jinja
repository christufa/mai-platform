{%- set tag = ('runtime-' ~ image_version) if image_version else 'runtime' -%}
name: ci

on:
  push:
    branches: [main]
  pull_request:

permissions: {}

jobs:
  test:
    name: test
    runs-on: ubuntu-latest
    permissions:
      contents: read   # checkout
      packages: read   # pull the base image while the GHCR package is private
    # Tests run inside the same image the cloud jobs use (CPU-only here).
    container:
      image: {{ image_repo }}:{{ tag }}
      options: --user root
{%- raw %}
      credentials:
        username: ${{ github.actor }}
        password: ${{ secrets.GITHUB_TOKEN }}
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6.1.0
        with:
          persist-credentials: false
      - name: Install
        run: uv pip install --python /opt/venv/bin/python -c "$MAI_CONSTRAINTS" -e . pytest ruff
      - name: Lint
        run: ruff check . && ruff format --check .
      - name: Test
        run: pytest
{%- endraw %}
